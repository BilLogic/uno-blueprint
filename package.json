{
  "name": "uno-blueprint",
  "private": true,
  "version": "2.6.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bootstrap": {
      "types": "./src/bootstrap.ts",
      "default": "./src/bootstrap.ts"
    },
    "./styles.css": "./src/styles/tailwind.config.css",
    "./overlay": {
      "types": "./scripts/overlay.d.mts",
      "default": "./scripts/overlay.mjs"
    },
    "./vite-imports": {
      "types": "./scripts/vite-imports.d.mts",
      "default": "./scripts/vite-imports.mjs"
    },
    "./*": "./*"
  },
  "bin": {
    "render-walk": "./render-walk/run.mjs"
  },
  "scripts": {
    "predev": "node scripts/sync-cover-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-cover-assets.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run -s check:skills && vitest run",
    "manifest": "node scripts/generate-identifier-manifest.mjs",
    "check:manifest": "node scripts/generate-identifier-manifest.mjs --check",
    "check:version": "node scripts/check-version-agreement.mjs",
    "check:parity": "python3 scripts/adapter_parity.py",
    "check:portable-core": "node scripts/generate-portable-core.mjs --check",
    "check:portable-schema": "node scripts/generate-portable-schema.mjs --check",
    "check:instance-vocabulary": "node scripts/check-instance-vocabulary.mjs",
    "check:band": "node scripts/check-migration-band.mjs",
    "check:target": "node scripts/check-target-schema.mjs",
    "check:identifiers": "node scripts/check-retired-identifiers.mjs",
    "check:database-names": "node scripts/check-database-names.mjs",
    "check:pinned-shapes": "node scripts/check-pinned-shapes.mjs",
    "test:ir": "bash scripts/tests/run_tests.sh",
    "slice:annotation-drag": "vitest run src/slices/annotationDrag.slice.test.tsx",
    "slice:cell-edit": "vitest run src/slices/cellEditRevert.slice.test.tsx",
    "slice:agent-session": "vitest run src/slices/agentSession.slice.test.tsx",
    "slice:phone-agent-jump": "vitest run src/slices/phoneAgentJump.slice.test.tsx",
    "slice:cell-edit:postgrest": "node scripts/run-slice-over-postgrest.mjs --prove",
    "version": "changeset version && node scripts/check-version-agreement.mjs --write",
    "preview": "vite preview",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "generate:database-types": "node scripts/generate-database-types.mjs",
    "check:database-types": "node scripts/generate-database-types.mjs --check",
    "setup:env": "cp -n .env.example .env 2>/dev/null || cp .env.example .env",
    "sync:canvas-skills": "node scripts/sync-canvas-skills.mjs",
    "sync:agent-skills": "node scripts/sync-agent-skills.mjs",
    "sync:skills": "node scripts/sync-canvas-skills.mjs && node scripts/sync-agent-skills.mjs",
    "check:skills": "node scripts/sync-canvas-skills.mjs --check && node scripts/sync-agent-skills.mjs --check",
    "agent:harness": "node scripts/agent-harness/run.mjs",
    "agent:harness:smoke": "node scripts/agent-harness/run.mjs --smoke",
    "generate:portable-core": "node scripts/generate-portable-core.mjs",
    "generate:portable-schema": "node scripts/generate-portable-schema.mjs",
    "check:rpc-arguments": "node scripts/check-rpc-arguments.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "check:content-coupling": "node scripts/check-content-coupling.mjs",
    "check:storage-keys": "node scripts/check-storage-keys.mjs",
    "check:sample-content": "node scripts/check-sample-content.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "docs:index": "node scripts/generate-docs-index.mjs",
    "check:docs-index": "node scripts/generate-docs-index.mjs --check",
    "check:dependency-kinds": "node scripts/check-dependency-kinds.mjs",
    "check:harness": "node scripts/check-harness-claims.mjs",
    "check:doc-paths": "node scripts/check-doc-paths.mjs",
    "check:reference-paths": "node scripts/check-reference-paths.mjs",
    "check:render-walk": "node render-walk/run.mjs",
    "check:budget": "node scripts/check-router-budget.mjs",
    "check:negation": "node scripts/check-negation-ratchet.mjs",
    "check:pointers": "node scripts/check-pointers.mjs",
    "check:seed-load": "node scripts/check-seed-loads.mjs",
    "check:function-bodies": "node scripts/check-function-bodies.mjs",
    "check:deployment-seed-load": "node scripts/check-deployment-seed-loads.mjs",
    "check:glossary": "node scripts/check-glossary-only.mjs",
    "check:hosting": "node scripts/check-hosting-rules.mjs",
    "interface-map": "node scripts/generate-interface-schema-map.mjs",
    "check:interface-map": "node scripts/generate-interface-schema-map.mjs --check",
    "agent-account": "node scripts/generate-agent-account.mjs",
    "check:agent-account": "node scripts/generate-agent-account.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/ubuntu-sans": "^5.3.0",
    "@fontsource-variable/ubuntu-sans-mono": "^5.3.0",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@supabase/postgrest-typegen": "^0.2.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "playwright": "1.62.0",
    "rolldown": "~1.2.1",
    "supabase": "^2.106.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
