{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "locales",
    "service"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2026.09.11",
        "2026.09.10",
        "2026.09.09",
        "2026.09.08",
        "2026.09.07",
        "2026.09.06",
        "2026.09.05",
        "2026.09.04",
        "2026.09.03",
        "2026.09.02",
        "2026.09.01",
        "2026.08.31",
        "2026.08.27",
        "2026.08.26",
        "2026.08.25",
        "2026.07.16"
      ]
    },
    "locales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locale"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "service": {
      "$ref": "#/$defs/service"
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "localeText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/locale"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "cellRef": {
      "type": "object",
      "required": [
        "lane",
        "step"
      ],
      "additionalProperties": false,
      "properties": {
        "lane": {
          "$ref": "#/$defs/key"
        },
        "step": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/localeText"
        },
        "url": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "link",
            "attachment"
          ]
        },
        "featured": {
          "type": "boolean"
        }
      }
    },
    "touchpoint": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/localeText"
        },
        "summary": {
          "$ref": "#/$defs/localeText"
        },
        "role": {
          "enum": [
            "core",
            "peripheral"
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "key",
        "name",
        "phases"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "$ref": "#/$defs/localeText"
        },
        "summary": {
          "$ref": "#/$defs/localeText"
        },
        "entity_examples": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/localeText"
          }
        },
        "touchpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registryTouchpoint"
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase"
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "key",
        "name",
        "order",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "$ref": "#/$defs/localeText"
        },
        "summary": {
          "$ref": "#/$defs/localeText"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "loops_to": {
          "$ref": "#/$defs/key"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "key",
        "name",
        "order",
        "layout",
        "steps",
        "paths"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "$ref": "#/$defs/localeText"
        },
        "summary": {
          "$ref": "#/$defs/localeText"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "enum": [
            "stacked",
            "merged"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "key",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "$ref": "#/$defs/localeText"
        }
      }
    },
    "path": {
      "type": "object",
      "required": [
        "key",
        "name",
        "kind",
        "lanes",
        "path_steps",
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "$ref": "#/$defs/localeText"
        },
        "summary": {
          "$ref": "#/$defs/localeText"
        },
        "note": {
          "$ref": "#/$defs/localeText"
        },
        "kind": {
          "enum": [
            "happy",
            "variant",
            "exception"
          ]
        },
        "variant_label": {
          "$ref": "#/$defs/localeText"
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lane"
          }
        },
        "path_steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "lane": {
      "type": "object",
      "required": [
        "key",
        "display_name",
        "row"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "display_name": {
          "$ref": "#/$defs/localeText"
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "customer_actions",
            "frontstage_actions",
            "backstage_actions",
            "partner_actions",
            "frontstage_touchpoints",
            "backstage_touchpoints",
            "support_actions",
            "storyboard",
            null
          ]
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "kpis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "lane",
        "step"
      ],
      "additionalProperties": false,
      "properties": {
        "lane": {
          "$ref": "#/$defs/key"
        },
        "step": {
          "$ref": "#/$defs/key"
        },
        "content": {
          "$ref": "#/$defs/localeText"
        },
        "summary": {
          "$ref": "#/$defs/localeText"
        },
        "frame": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "touchpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/touchpoint"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "needs_review": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attribution": {
          "type": "string"
        },
        "function": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "perceived_owner": {
          "type": "string"
        },
        "value_props": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "for",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "for": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "source",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/cellRef"
        },
        "target": {
          "$ref": "#/$defs/cellRef"
        },
        "kind": {
          "enum": [
            "leads_to",
            "enables"
          ],
          "default": "leads_to"
        }
      }
    },
    "registryTouchpoint": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/localeText"
        },
        "kind": {
          "enum": [
            "app",
            "document",
            "physical",
            "channel",
            "service",
            "other"
          ]
        },
        "summary": {
          "$ref": "#/$defs/localeText"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
